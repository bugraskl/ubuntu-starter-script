# =============================================================================
#  ubuntu-starter-script ayarları
#  1 = aç / kur,  0 = kapat / kurma
#  Bu dosya install.sh tarafından otomatik okunur.
# =============================================================================

# --- Genel -------------------------------------------------------------------
# Kurulumun yapılacağı kullanıcı. Boş bırakılırsa scripti çalıştıran kullanıcı.
TARGET_USER=""
TIMEZONE="Europe/Istanbul"
# Kurulumdan önce tüm sistem paketlerini güncelle (apt full-upgrade)
UPGRADE_SYSTEM=1

# --- Kurulacaklar ------------------------------------------------------------
INSTALL_PYTHON=1          # Python 3 + sanal ortam (venv)
INSTALL_PY_PACKAGES=1     # requirements.txt içindeki paketler (pypylon, OpenCV, snap7...)
INSTALL_WEB=1             # Apache2 + PHP + MySQL
INSTALL_PHPMYADMIN=0      # Veritabanı için web arayüzü (http://localhost/phpmyadmin)
INSTALL_PYLON=1           # Basler pylon Software Suite (pylon Viewer dahil)
CAMERA_TUNING=1           # USB3/GigE kamera performans ayarları (Basler önerileri)
INSTALL_CHROMIUM=1        # Chromium tarayıcı (snap)
INSTALL_SSH=1             # Uzaktan erişim için OpenSSH sunucusu
INSTALL_VSCODE=0          # Visual Studio Code
INSTALL_OPENCV_CPP=0      # OpenCV C++ geliştirme paketleri (libopencv-dev)

# --- MySQL -------------------------------------------------------------------
# Uygulama için veritabanı ve kullanıcı oluştur.
# Şifre boşsa rastgele üretilir ve ~/ubuntu-starter-credentials.txt dosyasına yazılır.
DB_CREATE=1
DB_NAME="app_db"
DB_USER="app_user"
DB_PASS=""

# --- Python ------------------------------------------------------------------
# Tüm Python paketleri bu sanal ortama kurulur (Ubuntu 24.04 sistem Python'una pip izin vermez).
VENV_DIR="/opt/venv"
PYTHON_REQUIREMENTS="requirements.txt"

# --- Basler pylon --------------------------------------------------------------
# Yeni sürüm çıkınca: https://www.baslerweb.com/en/downloads/software/ adresinden
# "Linux x86 (64 Bit) Debian Installer Package" linkini alıp aşağıya yazın.
# İnternet yoksa .tar.gz dosyasını downloads/ klasörüne koymanız yeterli.
PYLON_VERSION="26.08.1"
PYLON_URL_X86_64="https://downloads-ctf.baslerweb.com/dg51pdwahxgw/2RfxolIRgwIS2XcOo6WUbR/8b92c4d22d355d6423a1e2adf6fa09be/pylon-26.08.1_linux-x86_64_debs.tar.gz"
PYLON_URL_AARCH64="https://downloads-ctf.baslerweb.com/dg51pdwahxgw/5Js1NCjgyAD2Ew6K6VMEkI/f6a279b246f3d5f5d190fb60e4fb6cbb/pylon-26.08.1_linux-aarch64_debs.tar.gz"
PYLON_INSTALL_CODEMETER=1   # pylon vTools lisanslaması için CodeMeter (Basler talimatındaki gibi)
PYLON_FORCE_REINSTALL=0
DOWNLOAD_DIR="downloads"

# --- Kamera ayarları (CAMERA_TUNING=1 ise) -------------------------------------
USBFS_MEMORY_MB=1000        # USB3 kameralar için USB-FS bellek limiti (Linux varsayılanı 16)
GIGE_RMEM_MAX=16777216      # GigE kameralar için soket alma tamponu üst sınırı (16 MB)

# --- Kiosk modu (açılışta Chromium tam ekran arayüzü gösterir) ---------------
KIOSK_ENABLE=0
KIOSK_URL="http://localhost/"
KIOSK_AUTOLOGIN=1               # Açılışta şifresiz otomatik oturum aç
KIOSK_DISABLE_SCREEN_BLANK=1    # Ekran kararmasın / kilitlenmesin
# Chromium snap otomatik güncellemesini durdur (kiosk açıksa varsayılan olarak durdurulur)
# CHROMIUM_HOLD_UPDATES=1

# --- Sistem ------------------------------------------------------------------
DISABLE_WAYLAND=0         # 1 = Xorg (X11) oturumu kullan (uzak masaüstü / ekran araçları için daha uyumlu)
DISABLE_AUTO_UPDATES=0    # 1 = üretim makinesinde otomatik güncellemeleri kapat
